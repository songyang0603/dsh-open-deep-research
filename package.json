{
  "name": "dsh-open-deep-research",
  "version": "0.1.0-alpha.4",
  "private": true,
  "publishConfig": {
    "access": "public",
    "tag": "next"
  },
  "description": "A configurable DSH-native Deep Research agent and reference implementation.",
  "type": "module",
  "bin": {
    "dsh-open-deep-research-init": "./dist/init-profile.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./service": {
      "types": "./dist/service.d.ts",
      "default": "./dist/service.js"
    },
    "./provider": {
      "types": "./dist/provider.d.ts",
      "default": "./dist/provider.js"
    },
    "./tool": {
      "types": "./dist/tool.d.ts",
      "default": "./dist/tool.js"
    },
    "./app-startup": {
      "types": "./dist/app-startup.d.ts",
      "default": "./dist/app-startup.js"
    },
    "./app-runner": {
      "types": "./dist/app-runner.d.ts",
      "default": "./dist/app-runner.js"
    },
    "./jina-reader-prerequisite": {
      "types": "./dist/jina-reader-prerequisite.d.ts",
      "default": "./dist/jina-reader-prerequisite.js"
    },
    "./research-profile.patch.yml": "./bundle/research-profile.patch.yml",
    "./research-profile-jina.patch.yml": "./bundle/research-profile-jina.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "bundle",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "dist",
    "docs",
    "LICENSE",
    "README.md",
    "README.zh-CN.md",
    "SECURITY.md",
    "src"
  ],
  "dsh": {
    "bundle": {
      "patch": "./bundle/cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm build && pnpm test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "oxlint src tests examples",
    "prepare": "pnpm build",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/songyang0603/dsh-open-deep-research.git"
  },
  "homepage": "https://github.com/songyang0603/dsh-open-deep-research#readme",
  "bugs": {
    "url": "https://github.com/songyang0603/dsh-open-deep-research/issues"
  },
  "packageManager": "pnpm@10.19.0",
  "keywords": [
    "deep-research",
    "deepseek-harness",
    "dsh",
    "agent"
  ],
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.1",
    "commander": "^15.0.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/cordis-plugin-loader": "^1.0.2",
    "@deepseek-ai/dsh-agent": "0.1.0-rc.7",
    "@deepseek-ai/dsh-agent-default-model": "0.1.0-rc.7",
    "@deepseek-ai/dsh-cmdline": "0.1.0-rc.7",
    "@deepseek-ai/dsh-llm": "0.1.0-rc.7",
    "@deepseek-ai/dsh-mcp-client": "0.1.0-rc.7",
    "@deepseek-ai/dsh-session": "0.1.0-rc.7",
    "@deepseek-ai/dsh-subagent": "0.1.0-rc.7",
    "@deepseek-ai/dsh-system-prompt": "0.1.0-rc.7",
    "@deepseek-ai/dsh-tools": "0.1.0-rc.7"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-mcp-client": {
      "optional": true
    }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.1",
    "@deepseek-ai/cordis-plugin-include": "1.0.6",
    "@deepseek-ai/cordis-plugin-loader": "1.0.2",
    "@deepseek-ai/dsh-agent": "0.1.0-rc.7",
    "@deepseek-ai/dsh-agent-default-model": "0.1.0-rc.7",
    "@deepseek-ai/dsh-agent-loop": "0.1.0-rc.7",
    "@deepseek-ai/dsh-agent-loop-testkit": "0.1.0-rc.7",
    "@deepseek-ai/dsh-attachment": "0.1.0-rc.7",
    "@deepseek-ai/dsh-brand": "0.1.0-rc.7",
    "@deepseek-ai/dsh-cmdline": "0.1.0-rc.7",
    "@deepseek-ai/dsh-code-runtime": "0.1.0-rc.7",
    "@deepseek-ai/dsh-invariants": "0.1.0-rc.7",
    "@deepseek-ai/dsh-llm": "0.1.0-rc.7",
    "@deepseek-ai/dsh-mcp-client": "0.1.0-rc.7",
    "@deepseek-ai/dsh-scope": "0.1.0-rc.7",
    "@deepseek-ai/dsh-session": "0.1.0-rc.7",
    "@deepseek-ai/dsh-session-persistence": "0.1.0-rc.7",
    "@deepseek-ai/dsh-settings": "0.1.0-rc.7",
    "@deepseek-ai/dsh-subagent": "0.1.0-rc.7",
    "@deepseek-ai/dsh-subagent-in-process-driver": "0.1.0-rc.7",
    "@deepseek-ai/dsh-subagent-spawn-in-process": "0.1.0-rc.7",
    "@deepseek-ai/dsh-subprocess": "0.1.0-rc.7",
    "@deepseek-ai/dsh-system-prompt": "0.1.0-rc.7",
    "@deepseek-ai/dsh-timeout": "0.1.0-rc.7",
    "@deepseek-ai/dsh-tools": "0.1.0-rc.7",
    "@deepseek-ai/dsh-typert-protocol": "0.1.0-rc.7",
    "@deepseek-ai/dsh-user-approval": "0.1.0-rc.7",
    "@types/node": "^22.15.0",
    "oxlint": "^1.12.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
